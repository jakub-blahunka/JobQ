<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing goes to cloud backup. A direct phone-to-phone transfer carries the job data over,
     but not the multi-gigabyte model files, and not the CV: it is encrypted with a key that
     never leaves this device's Keystore, so a copy would be unreadable on the new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="models/" />
        <exclude domain="file" path="documents/" />
    </device-transfer>
</data-extraction-rules>
